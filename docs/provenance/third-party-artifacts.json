    {
      "name": "libvterm",
      "version": "0.3.3",
      "source": "https://www.leonerd.org.uk/code/libvterm/libvterm-0.3.3.tar.gz",
      "source_archive_sha256": "09156f43dd2128bd347cbeebe50d9a571d32c64e0cf18d211197946aff7226e0",
      "source_tag_commit": "9d6d2112335080312ef8c36667fa717ded4f7daf",
      "local_patches": [
        {
          "file": "vendor/libvterm/src/screen.c",
          "function": "erase_internal",
          "summary": "Skip cells where getcell() returns NULL instead of writing through the null pointer. The row loop bounds against screen->state->rows while getcell() checks screen->rows, and the column loop is not bounded by screen->cols, so an erase rect derived from the state can outrun the screen buffer. Reachable by interleaving term_resize with term_pump; found by fuzz/run.sh term."
        },
        {
          "file": "vendor/libvterm/src/screen.c",
          "function": "putglyph",
          "summary": "Stop writing continuation cells for a double-width glyph once getcell() returns NULL. A wide glyph placed on the final column has no room for its continuation cell, and the unconditional dereference of getcell()'s result was undefined behaviour that let the compiler elide the bounds checks and write one cell past the screen buffer. Deterministic Segmentation_Fault on linux_amd64; found by term.fuzz_vterm_ingest in Linux CI."
        },
        {
          "file": "vendor/libvterm/src/encoding.c",
          "function": "decode_utf8",
          "summary": "Do not emit two codepoints when only one slot remains. The ASCII branch writes the U+FFFD marker for an abandoned multi-byte sequence followed by the character itself, but the loop guard only proves room for one, so landing the pair on the last slot wrote one uint32 past the end of vt->tmpbuffer and corrupted the C heap. Reachable from any terminal output containing a truncated UTF-8 sequence; it made scripts/test.sh abort about 43% of the time."
        }
      ],
      "license": "MIT",
      "build": "scripts/build-libvterm.sh and scripts/build-libvterm.bat",
      "notices": [
        "vendor/libvterm/LICENSE",
        "THIRD_PARTY_NOTICES.md"
      ],
      "artifacts": [
        {
          "path": "libvterm/lib/darwin_arm64/libvterm.a",
          "sha256": "8a0befd7432dd0d384e457eddbf2ae900105ce30b1f39f43182274472044a111",
          "built_from": "patched"
        },
        {
          "path": "libvterm/lib/darwin_amd64/libvterm.a",
          "sha256": "c618fe7f4bbfb44333ea5762cde925d146646cb5e83b46a32915e905a2e33fce",
          "built_from": "patched"
        },
        {
          "path": "libvterm/lib/windows_amd64/vterm.lib",
          "sha256": "726100141eba902aeef49ee134ea3b88767f558ef691d35091526ae29d89e369",
          "built_from": "upstream-unpatched",
