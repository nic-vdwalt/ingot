# Tiger Style: tabs (width 4), 100-column lines. See docs/TIGER_STYLE.md.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.odin]
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 100

[*.{sh,md,json,wgsl,glsl}]
indent_style = space
indent_size = 2
